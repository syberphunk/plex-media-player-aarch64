+/*
+ * Players often open the decoder before the pixel format is known, but the
+ * profile is already set from the container. Use it so the right capture
+ * format is requested on the first attempt.
+ */
+static int v4l2_is_10bit_stream(const AVCodecContext *avctx, enum AVPixelFormat pixfmt)
+{
+    /* a pixel format that is already known decides */
+    if (pixfmt != AV_PIX_FMT_NONE)
+        return pixfmt == AV_PIX_FMT_YUV420P10LE;
+
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_HEVC:
+        if (avctx->profile != AV_PROFILE_UNKNOWN)
+            return avctx->profile == AV_PROFILE_HEVC_MAIN_10;
+        /* players such as mpv open the decoder before the profile is parsed;
+         * the hvcC header in extradata (Matroska, MP4) already has the depth */
+        if (avctx->extradata_size >= 23 && avctx->extradata[0] == 1)
+            return (avctx->extradata[17] & 7) + 8 == 10;
+        return 0;
+    case AV_CODEC_ID_VP9:
+        return avctx->profile == AV_PROFILE_VP9_2;
+    case AV_CODEC_ID_H264:
+        /* the low byte is the profile, the rest are constraint flags */
+        return (avctx->profile & 0xff) == AV_PROFILE_H264_HIGH_10;
+    default:
+        return 0;
+    }
+}
