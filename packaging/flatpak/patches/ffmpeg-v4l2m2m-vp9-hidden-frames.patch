+static int v4l2_vp9_hidden(const uint8_t *data, int size)
+{
+    int pos = 4;
+
+    if (size < 1 || (data[0] >> 6) != 2)
+        return 0;
+    if (((data[0] >> 4) & 3) == 3)
+        pos++;
+    if ((data[0] >> (7 - pos)) & 1)
+        return 0;
+    pos += 2;
+    return !((data[0] >> (7 - pos)) & 1);
+}
+
