+static void v4l2_requeue_capture(V4L2m2mContext *s)
+{
+    V4L2Context *const capture = &s->capture;
+    int i;
+
+    if (s->draining || !capture->streamon || capture->done || !capture->buffers)
+        return;
+
+    for (i = 0; i < capture->num_buffers; i++) {
+        if (capture->buffers[i].status == V4L2BUF_AVAILABLE)
+            ff_v4l2_buffer_enqueue(&capture->buffers[i]);
+    }
+}
