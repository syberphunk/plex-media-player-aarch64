 }
 
+static void v4l2_decode_flush(AVCodecContext *avctx)
+{
+    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+    V4L2Context *const capture = &s->capture;
+    V4L2Context *const output = &s->output;
+    int i, ret;
+
+    av_packet_unref(&s->buf_pkt);
+
+    if (output->streamon) {
+        ret = ff_v4l2_context_set_status(output, VIDIOC_STREAMOFF);
+        if (ret)
+            av_log(avctx, AV_LOG_WARNING, "VIDIOC_STREAMOFF on output context\n");
+    }
+
+    if (capture->streamon) {
+        ret = ff_v4l2_context_set_status(capture, VIDIOC_STREAMOFF);
+        if (ret)
+            av_log(avctx, AV_LOG_WARNING, "VIDIOC_STREAMOFF on capture context\n");
+    }
+
+    for (i = 0; output->buffers && i < output->num_buffers; i++) {
+        if (output->buffers[i].status == V4L2BUF_IN_DRIVER)
+            output->buffers[i].status = V4L2BUF_AVAILABLE;
+    }
+
+    for (i = 0; capture->buffers && i < capture->num_buffers; i++) {
+        if (capture->buffers[i].status == V4L2BUF_IN_DRIVER)
+            capture->buffers[i].status = V4L2BUF_AVAILABLE;
+    }
+
+    s->draining = 0;
+    output->done = 0;
+    capture->done = 0;
+
+    if (!capture->buffers)
+        return;
+
+    ret = ff_v4l2_context_set_status(capture, VIDIOC_STREAMON);
+    if (ret) {
+        av_log(avctx, AV_LOG_WARNING, "VIDIOC_STREAMON on capture context\n");
+        return;
+    }
+
+    v4l2_requeue_capture(s);
+}
